{
  "lexicon": 1,
  "id": "tools.spec.event.anki.reviewed",
  "description": "User reviewed a flashcard in an SRS system.",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "extends": "tools.spec.event.defs#signedEventBase",
      "record": {
        "type": "object",
        "required": [
          "cardId",
          "grade",
          "reviewedAt"
        ],
        "properties": {
          "cardId": {
            "type": "string"
          },
          "front": {
            "type": "string"
          },
          "back": {
            "type": "string"
          },
          "grade": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5,
            "description": "SRS grade (0-5, SM-2 algorithm convention)"
          },
          "interval": {
            "type": "integer",
            "minimum": 0,
            "description": "Current interval in days (from SRS system)"
          },
          "languageCode": {
            "type": "string",
            "maxLength": 10,
            "default": "ko"
          },
          "difficulty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "reviewedAt": {
            "type": "string",
            "format": "datetime"
          },
          "register": {
            "type": "string",
            "enum": [
              "formal_written",
              "formal_speech",
              "informal_speech",
              "colloquial",
              "literary"
            ],
            "default": "formal_written",
            "description": "Register of the card content"
          }
        }
      }
    }
  }
}
