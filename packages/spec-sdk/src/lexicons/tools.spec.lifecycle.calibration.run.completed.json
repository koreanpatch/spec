{
  "lexicon": 1,
  "id": "tools.spec.lifecycle.calibration.run.completed",
  "description": "A complete IRT calibration run has finished. Emitted by the IRT fitter after convergence or failure. Downstream consumers: monitoring dashboards, alert systems, downstream pipelines that depend on updated irt_item_params.\n",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "calibrationRunId",
          "completedAt",
          "numLearners",
          "numItems",
          "converged",
          "numItemParamsUpdated",
          "numAbilityStatesUpdated"
        ],
        "properties": {
          "calibrationRunId": {
            "type": "string",
            "maxLength": 128,
            "description": "Foreign key to irt_calibration_run."
          },
          "completedAt": {
            "type": "string",
            "format": "datetime",
            "description": "UTC timestamp when the run completed."
          },
          "numLearners": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of learners processed."
          },
          "numItems": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of items calibrated."
          },
          "converged": {
            "type": "boolean",
            "description": "Whether the algorithm converged."
          },
          "numItemParamsUpdated": {
            "type": "integer",
            "description": "Number of irt_item_params records written/updated."
          },
          "numAbilityStatesUpdated": {
            "type": "integer",
            "description": "Number of irt_ability_state records written."
          },
          "failureReason": {
            "type": "string",
            "description": "If not converged, reason for failure."
          },
          "languageCode": {
            "type": "string",
            "maxLength": 10,
            "default": "ko"
          }
        }
      }
    }
  }
}
