{
  "lexicon": 1,
  "id": "tools.spec.srs.card.created",
  "description": "A new SRS card was created. Anchored to a specific item (lemma | morpheme | grammar_pattern | compound | entity). See RFC 013 in spec-research-suite/docs/lexicons/proposals/013_srs_card_and_review_outcome.md.\n",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "extends": "tools.spec.event.defs#signedEventBase",
      "record": {
        "type": "object",
        "required": [
          "learnerDid",
          "cardKey",
          "itemType",
          "itemRef",
          "createdAt"
        ],
        "properties": {
          "learnerDid": {
            "type": "string",
            "format": "did"
          },
          "cardKey": {
            "type": "string",
            "maxLength": 128,
            "description": "sha256(learnerDid + itemType + itemRef + miningSourceId)."
          },
          "itemType": {
            "type": "string",
            "enum": [
              "lemma",
              "morpheme",
              "grammar_pattern",
              "compound",
              "entity"
            ]
          },
          "itemRef": {
            "type": "object",
            "description": "Discriminated union — one of lemmaRef / morphemePatternId+hostLemma / grammarPatternId+hostLemma / compoundRef / entityRef.",
            "properties": {
              "lemmaRef": {
                "type": "object",
                "ref": "tools.spec.event.encounter_defs#hostLemmaRef"
              },
              "morphemePatternId": {
                "type": "string",
                "maxLength": 128
              },
              "morphemeHostLemma": {
                "type": "object",
                "ref": "tools.spec.event.encounter_defs#hostLemmaRef"
              },
              "grammarPatternId": {
                "type": "string",
                "maxLength": 128
              },
              "grammarPatternHostLemma": {
                "type": "object",
                "ref": "tools.spec.event.encounter_defs#hostLemmaRef"
              },
              "compoundRef": {
                "type": "object",
                "properties": {
                  "compositeLemma": {
                    "type": "object",
                    "ref": "tools.spec.event.encounter_defs#hostLemmaRef"
                  },
                  "compoundType": {
                    "type": "string",
                    "enum": [
                      "verbal",
                      "noun_native",
                      "noun_hanja",
                      "noun_hybrid"
                    ]
                  }
                }
              },
              "entityRef": {
                "type": "object",
                "ref": "tools.spec.event.encounter_defs#hostLemmaRef"
              }
            }
          },
          "miningSource": {
            "type": "object",
            "description": "Provenance for a card mined from source text. Full source sentence surface text must NEVER appear on the public firehose (see RECORD_REFERENCE_HIERARCHY.md S5); reference the source by sentenceId + contentHash only.",
            "properties": {
              "sentenceId": {
                "type": "string",
                "maxLength": 128
              },
              "content": {
                "type": "object",
                "ref": "tools.spec.content.defs#contentRef",
                "description": "Content-addressed reference (contentHash) to the mined source sentence. Replaces the removed sentenceSurface field."
              },
              "audioRef": {
                "type": "string",
                "maxLength": 256
              }
            }
          },
          "presentation": {
            "type": "object",
            "description": "Card display metadata. Copyright boundary (see RECORD_REFERENCE_HIERARCHY.md S5): cardFront/cardBack must carry only the item, its gloss/definition, or the learner's own study text — NEVER a copyrighted source passage or a cloze of one. The source/context sentence is not stored inline (the former contextSentence field was removed); reference it via miningSource.content (contentHash) and reconstruct the display client-side.",
            "properties": {
              "cardFront": {
                "type": "string",
                "maxLength": 256,
                "description": "Card front (prompt). Item/gloss/user-authored text only — must not inline a copyrighted source sentence, including as a cloze. Reference source context by contentHash (miningSource.content)."
              },
              "cardBack": {
                "type": "string",
                "maxLength": 1024,
                "description": "Card back (answer/definition). Item/gloss/user-authored text only — must not inline a copyrighted source passage. Reference source context by contentHash (miningSource.content)."
              },
              "frontCloze": {
                "type": "boolean"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "registerTag": {
                "type": "string",
                "ref": "tools.spec.event.encounter_defs#formalityTier"
              },
              "sensitivityClass": {
                "type": "string",
                "ref": "tools.spec.event.encounter_defs#sensitivityClass"
              }
            }
          },
          "initialState": {
            "type": "object",
            "properties": {
              "scheduler": {
                "type": "string",
                "enum": [
                  "fsrs",
                  "sm2",
                  "anki_default"
                ]
              },
              "stability": {
                "type": "number",
                "minimum": 0
              },
              "difficulty": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "nextDueAt": {
                "type": "string",
                "format": "datetime"
              },
              "intervalDays": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "scheduler",
              "nextDueAt"
            ]
          },
          "reviewCount": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "firstReviewedAt": {
            "type": "string",
            "format": "datetime"
          },
          "dictionaryRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "ref": "tools.spec.event.encounter_defs#dictionaryColumnRef"
            }
          }
        }
      }
    }
  }
}
